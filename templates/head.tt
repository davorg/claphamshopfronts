<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-KRMR11D4WG"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KRMR11D4WG');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f3e9">
  <meta name="description" content="[% page.description | html %]">
  <meta property="og:type" content="[% page.og_type | html %]">
  <meta property="og:title" content="[% page.title | html %]">
  <meta property="og:description" content="[% page.og_description | html %]">
  <meta property="og:image" content="[% page.social_image | html %]">
  <meta property="og:image:width" content="[% page.image_width | html %]">
  <meta property="og:image:height" content="[% page.image_height | html %]">
  <meta property="og:image:alt" content="[% page.image_alt | html %]">
  <meta name="twitter:card" content="summary_large_image">
  <title>[% page.title | html %]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="[% page.prefix | html %]styles.css">
  <link rel="canonical" href="[% page.canonical | html %]">
</head>
