<!DOCTYPE html>
<!-- Generated by bin/build-site.pl. Edit the TT template or source data and rebuild. -->
<html lang="en-GB">
[% INCLUDE head.tt -%]
<body[% IF page.body_class %] class="[% page.body_class | html %]"[% END %]>
  <a class="skip-link" href="#main">Skip to content</a>
[% INCLUDE nav.tt %]
[% content %]
[% INCLUDE footer.tt -%]
[% FOREACH script IN page.scripts -%]
  <script src="[% page.prefix | html %][% script | html %]" defer></script>
[% END -%]
</body>
</html>
