<!DOCTYPE html>
<!-- Generated by bin/build-site.pl. Edit the TT template or source data and rebuild. -->
<html lang="en-GB">
[% head %]
<body class="photo-archive-page">
  <a class="skip-link" href="#main">Skip to content</a>
[% header %]

  <main id="main" class="photo-archive-main wrap">
    <header class="photo-archive-heading">
      <p class="eyebrow">From the photographic archive</p>
      <h1>All photos</h1>
[% IF photo_count -%]
      <p>[% photo_count | html %] photograph[% IF photo_count != 1 %]s[% END %] of a changing neighbourhood, newest first. Follow a shopfront to discover its story.</p>
[% ELSE -%]
      <p>The photographic archive is just getting started. Check back soon for our first shopfronts.</p>
[% END -%]
    </header>

[% IF photo_count -%]
    <ul class="photo-archive-grid">
[% FOREACH photo IN photos -%]
      <li>
        <figure class="photo-archive-card">
          <a class="photo-archive-image" href="../[% photo.page_url | html %]" aria-label="View the photograph and story of [% photo.business_name | html %]">
            <img src="[% photo.small_url | html %]" srcset="[% photo.small_url | html %] [% photo.small_width | html %]w, [% photo.image_url | html %] [% photo.image_width | html %]w" sizes="(max-width: 600px) 90vw, (max-width: 900px) 44vw, 360px" width="[% photo.small_width | html %]" height="[% photo.small_height | html %]" alt="[% photo.caption | html %]" loading="lazy">
          </a>
          <figcaption>
            <time datetime="[% photo.taken_on | html %]">[% photo.photograph_date | html %]</time>
[% FOREACH subject IN photo.subjects -%]
            <div class="photo-archive-subject">
              <h2><a href="../[% subject.page_url | html %]">[% subject.business_name | html %]</a></h2>
              <p>[% subject.street_address | html %]</p>
              <p class="photo-archive-state">[% subject.status_label | html %] when photographed</p>
            </div>
[% END -%]
          </figcaption>
        </figure>
      </li>
[% END -%]
    </ul>
[% END -%]
  </main>

[% footer %]
</body>
</html>
