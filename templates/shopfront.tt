<!DOCTYPE html>
<!-- Generated by bin/build-site.pl. Edit the TT template or source data and rebuild. -->
<html lang="en-GB">
[% head %]
<body class="shopfront-page">
  <a class="skip-link" href="#main">Skip to content</a>
[% header %]

  <main id="main" class="shopfront-main wrap">
    <a class="archive-back" href="../../#recent-photographs"><span aria-hidden="true">←</span> Back to the photographs</a>
    <header class="shopfront-heading">
      <p class="eyebrow">From the photographic archive</p>
      <h1>[% business_name | html %]</h1>
      <p class="shopfront-address">[% address | html %] <span>[% postcode | html %]</span></p>
      <p class="shopfront-category">[% business_type | html %]</p>
    </header>

    <div class="shopfront-layout">
[% INCLUDE photograph.tt photo=main_photo eager=1 %]

      <div class="shopfront-story">
        <section aria-labelledby="record-title">
          <p class="eyebrow">A moment on the high street</p>
          <h2 id="record-title">What the photograph records</h2>
          <p class="archive-caption">[% caption | html %]</p>
          <dl class="archive-facts">
            <div><dt>Photographed</dt><dd><time datetime="[% taken_on | html %]">[% photograph_date | html %]</time></dd></div>
            <div><dt>Recorded state</dt><dd>[% status_at_date | html %]</dd></div>
            <div><dt>Business type</dt><dd>[% business_type | html %]</dd></div>
          </dl>
          <p class="archive-date-note">This record describes the premises on the photograph date. Later changes may not yet be included in the archive.</p>
        </section>

        <section class="archive-history" aria-labelledby="history-title">
          <h2 id="history-title">A few dates in the story</h2>
          <ol class="archive-timeline">
[% FOREACH event IN history -%]
            <li>
              <time datetime="[% event.date | html %]">[% event.display_date | html %]</time>
              <span class="archive-evidence-label">[% IF event.reported %]Reported · unconfirmed[% ELSE %]Documented[% END %]</span>
              <h3>[% event.title | html %]</h3>
              <p>[% event.description | html %]</p>
[% IF event.reported -%]
              <a href="[% event.source_url | html %]">[% event.source_label | html %] <span aria-hidden="true">↗</span></a>
[% END -%]
            </li>
[% END -%]
          </ol>
[% IF change_note -%]
          <p class="archive-change-note">[% change_note | html %]</p>
[% END -%]
        </section>

        <section class="archive-sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Sources &amp; links</h2>
          <ul>
[% FOREACH photo IN photo_sources -%]
            <li><a href="#photo-[% photo.id | html %]">Project photograph, <time datetime="[% photo.taken_on | html %]">[% photo.photograph_date | html %]</time></a>.</li>
[% END -%]
[% FOREACH source IN source_links -%]
            <li><a href="[% source.url | html %]">[% source.label | html %] <span aria-hidden="true">↗</span></a></li>
[% END -%]
          </ul>
        </section>
      </div>
    </div>

[% IF earlier_photos.size -%]
    <section class="archive-previous" aria-labelledby="earlier-title">
      <p class="eyebrow">The same address, over time</p>
      <h2 id="earlier-title">Earlier photographs</h2>
      <div class="archive-earlier-grid">
[% FOREACH photo IN earlier_photos -%]
[% INCLUDE photograph.tt photo=photo eager=0 %]
[% END -%]
      </div>
    </section>
[% END -%]

    <section class="archive-contribute" aria-labelledby="archive-contribute-title">
      <p class="handwritten">Help us fill in the gaps.</p>
      <h2 id="archive-contribute-title">Remember this shopfront?</h2>
      <p>If you know more about this address, have an older photograph, or can help confirm a date, we’d love to hear from you.</p>
      <a href="mailto:hello@claphamshopfronts.com">hello@claphamshopfronts.com <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <dialog class="photo-modal" id="photo-modal" aria-label="Larger photograph of [% business_name | html %]" aria-describedby="photo-modal-details">
    <form method="dialog">
      <button class="photo-modal-close" type="submit" aria-label="Close photograph" autofocus><span aria-hidden="true">×</span></button>
    </form>
    <img src="[% image_url | html %]" width="[% image_width | html %]" height="[% image_height | html %]" alt="[% caption | html %]">
    <div class="photo-modal-toolbar">
      <button class="photo-modal-nav photo-modal-previous" type="button" aria-label="Previous photograph"><span aria-hidden="true">←</span></button>
      <div class="photo-modal-details" id="photo-modal-details" aria-live="polite" aria-atomic="true">
        <p class="photo-modal-caption"></p>
        <p class="photo-modal-count"></p>
      </div>
      <button class="photo-modal-nav photo-modal-next" type="button" aria-label="Next photograph"><span aria-hidden="true">→</span></button>
    </div>
  </dialog>

[% footer %]
  <script src="../../photo-modal.js" defer></script>
</body>
</html>
